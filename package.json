{
  "name": "hanzi-writer",
  "version": "3.0.0",
  "author": "David Chanin <chanindav@gmail.com> (http://chanind.github.io/hanzi-writer/)",
  "description": "Hanzi Writer is a free and open-source javascript library for both animating simplified Chinese characters and quizzing users on character stroke order.",
  "repository": "chanind/hanzi-writer",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/HanziWriter.d.ts",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@sinonjs/fake-timers": "^15.3.2",
    "@types/jest": "^30.0.0",
    "@types/nise": "^1.4.5",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "codecov": "^3.8.3",
    "eslint": "10.2.1",
    "hanzi-writer-data": "^2.0.1",
    "jest-canvas-mock": "2.5.2",
    "babel-jest": "^30.3.0",
    "jest-cli": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-fetch-mock": "^3.0.3",
    "nise": "^6.1.5",
    "prettier": "^3.8.3",
    "rollup": "^4.60.2",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-license": "^3.7.1",
    "semantic-release": "^25.0.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "test": "jest",
    "lint-test": "eslint -c .eslintrc src",
    "lint-fix": "eslint --fix --ext .tsx,.ts .",
    "build": "rollup -c",
    "prepublishOnly": "rollup -c",
    "semantic-release": "semantic-release",
    "prettier": "prettier -w src",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "files": [
    "dist"
  ],
  "jest": {
    "setupFiles": [
      "jest-canvas-mock"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/../jest-setup.js"
    ],
    "rootDir": "src",
    "coverageDirectory": "../coverage/",
    "testEnvironmentOptions": {
      "url": "https://test.com/url#tag"
    },
    "collectCoverage": true,
    "testEnvironment": "<rootDir>/../jest-jsdom-env",
    "transform": {
      "^.+\\.[tj]sx?$": [
        "babel-jest",
        {
          "rootMode": "upward"
        }
      ]
    }
  }
}
